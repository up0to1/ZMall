        <hashTree/>
      </hashTree>
      <PostThreadGroup guiclass="ThreadGroupGui" testclass="PostThreadGroup" testname="tearDown-生成测试摘要" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="生成测试摘要" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.io.*;

String runDir = props.get(&quot;RUN_DIR&quot;);
String ts = props.get(&quot;TEST_TS&quot;);
if (runDir == null || ts == null) {
    log.info(&quot;==== tearDown: RUN_DIR null, skip&quot;);
    return;
}

String summaryPath = runDir + &quot;/summary.txt&quot;;
String testName = props.get(&quot;TEST_NAME&quot;);
if (testName == null) testName = &quot;aiOutfitAgentFunctional&quot;;

// 根据 testName 决定 CSV 前缀（detail_ 格式：username,step,code,... | validation_ 格式：caseName,expectedCode,actualCode,...）
String csvPrefix;
if (testName.equals(&quot;aiOutfitAgentFunctional&quot;)) {
    csvPrefix = &quot;aiOutfitAgentFunctional_detail_&quot;;
} else if (testName.equals(&quot;aiOutfitProductFunctional&quot;)) {
    csvPrefix = &quot;aiOutfitProductFunctional_detail_&quot;;
} else if (testName.equals(&quot;aiOutfitConcurrency&quot;)) {
    csvPrefix = &quot;aiOutfitConcurrency_detail_&quot;;
} else if (testName.equals(&quot;aiOutfitToolsCheck&quot;)) {
    csvPrefix = &quot;aiOutfitToolsCheck_detail_&quot;;
} else if (testName.equals(&quot;aiModelGenerateFunctional&quot;)) {
    csvPrefix = &quot;aiModelGenerateFunctional_detail_&quot;;
} else if (testName.equals(&quot;aiModelTaskList&quot;)) {
    csvPrefix = &quot;aiModelTaskList_detail_&quot;;
} else if (testName.equals(&quot;aiOutfitAgentFeedback&quot;)) {
    csvPrefix = &quot;aiOutfitAgentFeedback_detail_&quot;;
} else if (testName.equals(&quot;aiOutfitV3TwoStage&quot;)) {
    csvPrefix = &quot;aiOutfitV3TwoStage_detail_&quot;;
} else if (testName.equals(&quot;aiOutfitException&quot;)) {
    csvPrefix = &quot;aiOutfitException_validation_&quot;;
} else if (testName.equals(&quot;aiModelImageCrud&quot;)) {
    csvPrefix = &quot;aiModelImageCrud_validation_&quot;;
} else if (testName.equals(&quot;aiModelRating&quot;)) {
    csvPrefix = &quot;aiModelRating_validation_&quot;;
} else {
    csvPrefix = &quot;aiOutfitAgentFunctional_detail_&quot;;
}

int code200 = 0;
int code4xx = 0;
int code5xx = 0;
int codeOther = 0;
int total = 0;

File csvFile = new File(runDir + &quot;/&quot; + csvPrefix + ts + &quot;.csv&quot;);
if (!csvFile.exists()) {
    log.info(&quot;==== tearDown: CSV not found: &quot; + csvFile);
} else {
    BufferedReader br = new BufferedReader(new FileReader(csvFile));
    String line;
    while ((line = br.readLine()) != null) {
        // 跳过表头（detail_ 格式表头以 username, 开头，validation_ 格式表头以 caseName, 开头）
        if (line.startsWith(&quot;username,&quot;) || line.startsWith(&quot;caseName,&quot;)) continue;
        total++;
        // 两种格式 code/actualCode 均在第3列（index 2）
        String[] parts = line.split(&quot;,&quot;);
        String codeField = parts.length &gt; 2 ? parts[2].trim() : &quot;&quot;;
        if (codeField.equals(&quot;200&quot;)) code200++;
        else if (codeField.startsWith(&quot;4&quot;)) code4xx++;
        else if (codeField.startsWith(&quot;5&quot;)) code5xx++;
        else codeOther++;
    }
    br.close();
}

// 读取 PERF 统计
Long totalReq = (Long) props.get(&quot;PERF_TOTAL_REQ&quot;); if (totalReq == null) totalReq = 0L;
Long success = (Long) props.get(&quot;PERF_SUCCESS&quot;); if (success == null) success = 0L;
Long error = (Long) props.get(&quot;PERF_ERROR&quot;); if (error == null) error = 0L;
Long totalTime = (Long) props.get(&quot;PERF_TOTAL_TIME&quot;); if (totalTime == null) totalTime = 0L;
Long minTime = (Long) props.get(&quot;PERF_MIN_TIME&quot;); if (minTime == null) minTime = 0L;
Long maxTime = (Long) props.get(&quot;PERF_MAX_TIME&quot;); if (maxTime == null) maxTime = 0L;
Long startTs = (Long) props.get(&quot;PERF_START_TS&quot;); if (startTs == null) startTs = 0L;
Long endTs = (Long) props.get(&quot;PERF_END_TS&quot;); if (endTs == null) endTs = 0L;
long durationSec = startTs &gt; 0 &amp;&amp; endTs &gt; startTs ? (endTs - startTs) / 1000 : 0;
double avgTime = totalReq &gt; 0 ? (double) totalTime / totalReq : 0;
double successRate = totalReq &gt; 0 ? (double) success / totalReq * 100 : 0;
double tps = durationSec &gt; 0 ? (double) totalReq / durationSec : 0;

StringBuilder sb = new StringBuilder();
sb.append(&quot;========================================\n&quot;);
sb.append(&quot;  ZMall AI 功能测试摘要\n&quot;);
sb.append(&quot;========================================\n&quot;);
sb.append(&quot;测试名称: &quot; + testName + &quot;\n&quot;);
sb.append(&quot;测试时间: &quot; + ts + &quot;\n&quot;);
sb.append(&quot;结果目录: &quot; + runDir + &quot;\n&quot;);
sb.append(&quot;========================================\n\n&quot;);
sb.append(&quot;【请求统计】\n&quot;);
sb.append(String.format(&quot;总请求数: %d\n&quot;, totalReq));
sb.append(String.format(&quot;成功请求: %d (%.2f%%)\n&quot;, success, successRate));
sb.append(String.format(&quot;失败请求: %d\n&quot;, error));
sb.append(String.format(&quot;HTTP 200: %d\n&quot;, code200));
sb.append(String.format(&quot;HTTP 4xx: %d\n&quot;, code4xx));
sb.append(String.format(&quot;HTTP 5xx: %d\n&quot;, code5xx));
sb.append(String.format(&quot;其他:     %d\n&quot;, codeOther));
sb.append(&quot;\n【性能统计】\n&quot;);
sb.append(String.format(&quot;总耗时:   %ds\n&quot;, durationSec));
sb.append(String.format(&quot;平均耗时: %.2fms\n&quot;, avgTime));
sb.append(String.format(&quot;最小耗时: %dms\n&quot;, minTime));
sb.append(String.format(&quot;最大耗时: %dms\n&quot;, maxTime));
sb.append(String.format(&quot;吞吐量:   %.2f req/s\n&quot;, tps));
sb.append(&quot;\n【测试结论】\n&quot;);
if (successRate &gt;= 95) {
    sb.append(&quot;✓ 测试通过（成功率 &gt;= 95%）\n&quot;);
} else if (successRate &gt;= 80) {
    sb.append(&quot;△ 测试部分通过（成功率 80-95%，需关注失败原因）\n&quot;);
} else {
    sb.append(&quot;✗ 测试未通过（成功率 &lt; 80%，需排查问题）\n&quot;);
}

PrintWriter pw = new PrintWriter(new FileWriter(summaryPath));
pw.print(sb.toString());
pw.close();
log.info(&quot;==== tearDown: summary written to &quot; + summaryPath);
log.info(&quot;==== tearDown: total=&quot; + totalReq + &quot; success=&quot; + success + &quot; error=&quot; + error);
log.info(sb.toString());</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
