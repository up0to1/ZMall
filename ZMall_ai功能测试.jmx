        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 预处理程序" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">// 重置性能统计（避免跨测试运行数据累积）
props.remove(&quot;PERF_TOTAL_REQ&quot;);
props.remove(&quot;PERF_SUCCESS&quot;);
props.remove(&quot;PERF_ERROR&quot;);
props.remove(&quot;PERF_TOTAL_BYTES&quot;);
props.remove(&quot;PERF_TOTAL_SENT&quot;);
props.remove(&quot;PERF_TOTAL_TIME&quot;);
props.remove(&quot;PERF_MIN_TIME&quot;);
props.remove(&quot;PERF_MAX_TIME&quot;);
props.remove(&quot;PERF_START_TS&quot;);
props.remove(&quot;PERF_END_TS&quot;);
// 设置全局变量供 tearDown 使用
props.put(&quot;TEST_TS&quot;, vars.get(&quot;TEST_TS&quot;));
props.put(&quot;TEST_DATE&quot;, vars.get(&quot;TEST_DATE&quot;));
props.put(&quot;TEST_BASE&quot;, vars.get(&quot;TEST_BASE&quot;));
log.info(&quot;==== setUp: PERF stats reset, TEST_TS=&quot; + props.get(&quot;TEST_TS&quot;));</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="AI随心搭-风格驱动功能验证组" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="循环控制器">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="初始化测试目录" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="script">String testName = &quot;aiOutfitAgentFunctional&quot;;
String base = vars.get(&quot;TEST_BASE&quot;);
String date = vars.get(&quot;TEST_DATE&quot;);
String ts = vars.get(&quot;TEST_TS&quot;);
String runDir = base + &quot;/&quot; + date + &quot;_&quot; + testName + &quot;/&quot; + ts;
props.put(&quot;RUN_DIR&quot;, runDir);
props.put(&quot;TEST_NAME&quot;, testName);
vars.put(&quot;RUN_DIR&quot;, runDir);
vars.put(&quot;TEST_NAME&quot;, testName);
props.remove(&quot;PERF_TOTAL_REQ&quot;);
props.remove(&quot;PERF_SUCCESS&quot;);
props.remove(&quot;PERF_ERROR&quot;);
props.remove(&quot;PERF_TOTAL_BYTES&quot;);
props.remove(&quot;PERF_TOTAL_SENT&quot;);
props.remove(&quot;PERF_TOTAL_TIME&quot;);
props.remove(&quot;PERF_MIN_TIME&quot;);
props.remove(&quot;PERF_MAX_TIME&quot;);
props.remove(&quot;PERF_START_TS&quot;);
props.remove(&quot;PERF_END_TS&quot;);
vars.put(&quot;TASK_POLL_DONE&quot;, &quot;false&quot;);
File f = new File(runDir);
if (!f.exists()) f.mkdirs();
log.info(&quot;==== aiOutfitAgentFunctional RUN_DIR=&quot; + runDir);</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP信息头" enabled="true">
          <collectionProp name="HeaderManager.headers">
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">authorization</stringProp>
              <stringProp name="Header.value">${token}</stringProp>
            </elementProp>
            <elementProp name="" elementType="Header">
              <stringProp name="Header.name">Content-Type</stringProp>
              <stringProp name="Header.value">application/json</stringProp>
            </elementProp>
          </collectionProp>
        </HeaderManager>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="提交recommend任务" enabled="true">
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/outfit/agent/recommend</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;styleTags&quot;:[&quot;通勤&quot;,&quot;休闲&quot;],&quot;sceneDesc&quot;:&quot;日常上班&quot;,&quot;categories&quot;:[&quot;上衣&quot;,&quot;下装&quot;,&quot;鞋&quot;]}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="提取taskId并统计" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import java.io.*;
String res = prev.getResponseDataAsString();
String code = prev.getResponseCode();
long elapsed = prev.getTime();
long now = System.currentTimeMillis();
synchronized (&quot;PERF_LOCK&quot;) {
    Long totalReq = (Long) props.get(&quot;PERF_TOTAL_REQ&quot;); if (totalReq == null) totalReq = 0L;
    props.put(&quot;PERF_TOTAL_REQ&quot;, totalReq + 1);
    if (code.equals(&quot;200&quot;)) {
        Long success = (Long) props.get(&quot;PERF_SUCCESS&quot;); if (success == null) success = 0L;
        props.put(&quot;PERF_SUCCESS&quot;, success + 1);
        if (props.get(&quot;PERF_START_TS&quot;) == null) props.put(&quot;PERF_START_TS&quot;, now);
        props.put(&quot;PERF_END_TS&quot;, now + elapsed);
    } else {
        Long err = (Long) props.get(&quot;PERF_ERROR&quot;); if (err == null) err = 0L;
        props.put(&quot;PERF_ERROR&quot;, err + 1);
    }
    Long totalTime = (Long) props.get(&quot;PERF_TOTAL_TIME&quot;); if (totalTime == null) totalTime = 0L;
    props.put(&quot;PERF_TOTAL_TIME&quot;, totalTime + elapsed);
    Long minTime = (Long) props.get(&quot;PERF_MIN_TIME&quot;); if (minTime == null || elapsed &lt; minTime) props.put(&quot;PERF_MIN_TIME&quot;, elapsed);
    Long maxTime = (Long) props.get(&quot;PERF_MAX_TIME&quot;); if (maxTime == null || elapsed &gt; maxTime) props.put(&quot;PERF_MAX_TIME&quot;, elapsed);
    Long totalBytes = (Long) props.get(&quot;PERF_TOTAL_BYTES&quot;); if (totalBytes == null) totalBytes = 0L;
    props.put(&quot;PERF_TOTAL_BYTES&quot;, totalBytes + prev.getBytesAsLong());
    Long totalSent = (Long) props.get(&quot;PERF_TOTAL_SENT&quot;); if (totalSent == null) totalSent = 0L;
    props.put(&quot;PERF_TOTAL_SENT&quot;, totalSent + prev.getSentBytesAsLong());
}
String taskId = null;
int idx = res.indexOf(&quot;taskId&quot;);
if (idx &gt;= 0) {
    int s = res.indexOf(&quot;:&quot;, idx) + 1;
    while (s &lt; res.length() &amp;&amp; (res.charAt(s) == ' ' || res.charAt(s) == '&quot;')) s++;
    int e = s;
    while (e &lt; res.length() &amp;&amp; res.charAt(e) != '&quot;' &amp;&amp; res.charAt(e) != ',' &amp;&amp; res.charAt(e) != '}') e++;
    taskId = res.substring(s, e).trim();
}
vars.put(&quot;TASK_ID&quot;, taskId);
vars.put(&quot;TASK_SUBMIT_TIME&quot;, String.valueOf(now));
vars.put(&quot;TASK_SUBMIT_CODE&quot;, code);
vars.put(&quot;TASK_POLL_DONE&quot;, &quot;false&quot;);
String runDir = props.get(&quot;RUN_DIR&quot;);
String ts = props.get(&quot;TEST_TS&quot;);
new File(runDir).mkdirs();
String csvPath = runDir + &quot;/aiOutfitAgentFunctional_detail_&quot; + ts + &quot;.csv&quot;;
synchronized (csvPath.intern()) {
    File f = new File(csvPath);
    boolean needHeader = !f.exists();
    PrintWriter pw = new PrintWriter(new FileWriter(csvPath, true));
    if (needHeader) pw.println(&quot;username,code,taskId,elapsed,bytes,sentBytes,success&quot;);
    pw.println(vars.get(&quot;username&quot;) + &quot;,&quot; + code + &quot;,&quot; + (taskId == null ? &quot;&quot; : taskId) + &quot;,&quot; + elapsed + &quot;,&quot; + prev.getBytesAsLong() + &quot;,&quot; + prev.getSentBytesAsLong() + &quot;,&quot; + (code.equals(&quot;200&quot;) ? &quot;true&quot; : &quot;false&quot;));
    pw.close();
}
log.info(&quot;==== recommend: code=&quot; + code + &quot; taskId=&quot; + taskId + &quot; elapsed=&quot; + elapsed);</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="轮询结果-While" enabled="true">
          <stringProp name="WhileController.condition">${__javaScript(vars.get(&quot;TASK_POLL_DONE&quot;) != &quot;true&quot; &amp;&amp; vars.get(&quot;TASK_ID&quot;) != null,,)}</stringProp>
        </WhileController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="查询result" enabled="true">
            <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
            <stringProp name="HTTPSampler.port">${PORT}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.path">/api/v1/outfit/agent/result/${TASK_ID}</stringProp>
            <boolProp name="HTTPSampler.method">GET</boolProp>
            <boolProp name="HTTPSampler.use_keep_alive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="检查任务状态" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.io.*;
String res = prev.getResponseDataAsString();
long now = System.currentTimeMillis();
long submitTime = Long.parseLong(vars.get(&quot;TASK_SUBMIT_TIME&quot;));
long elapsed = (now - submitTime) / 1000;
String status = &quot;UNKNOWN&quot;;
int idx = res.indexOf(&quot;status&quot;);
if (idx &gt;= 0) {
    int s = res.indexOf(&quot;:&quot;, idx) + 1;
    while (s &lt; res.length() &amp;&amp; (res.charAt(s) == ' ' || res.charAt(s) == '&quot;')) s++;
    int e = s;
    while (e &lt; res.length() &amp;&amp; res.charAt(e) != '&quot;' &amp;&amp; res.charAt(e) != ',' &amp;&amp; res.charAt(e) != '}') e++;
    status = res.substring(s, e).trim();
}
log.info(&quot;==== poll result: status=&quot; + status + &quot; elapsed=&quot; + elapsed + &quot;s&quot;);
if (status.equalsIgnoreCase(&quot;SUCCESS&quot;) || status.equalsIgnoreCase(&quot;FAILED&quot;)) {
    vars.put(&quot;TASK_FINAL_STATUS&quot;, status);
    vars.put(&quot;TASK_POLL_DONE&quot;, &quot;true&quot;);
    String runDir = props.get(&quot;RUN_DIR&quot;);
    String ts = props.get(&quot;TEST_TS&quot;);
    String csvPath = runDir + &quot;/aiOutfitAgentFunctional_status_&quot; + ts + &quot;.csv&quot;;
    synchronized (csvPath.intern()) {
        File f = new File(csvPath);
        boolean needHeader = !f.exists();
        PrintWriter pw = new PrintWriter(new FileWriter(csvPath, true));
        if (needHeader) pw.println(&quot;taskId,finalStatus,durationSec&quot;);
        pw.println(vars.get(&quot;TASK_ID&quot;) + &quot;,&quot; + status + &quot;,&quot; + elapsed);
        pw.close();
    }
} else if (elapsed &gt; 180) {
    vars.put(&quot;TASK_FINAL_STATUS&quot;, &quot;TIMEOUT&quot;);
    vars.put(&quot;TASK_POLL_DONE&quot;, &quot;true&quot;);
    log.warn(&quot;==== task timeout after 180s, taskId=&quot; + vars.get(&quot;TASK_ID&quot;));
} else {
    try { Thread.sleep(3000); } catch (Exception ignore) {}
}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
        <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="查看结果树" enabled="true">
