        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="提取taskId并统计" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import java.io.*;
String res = prev.getResponseDataAsString();
String code = prev.getResponseCode();
long elapsed = prev.getTime();
long now = System.currentTimeMillis();
synchronized (&quot;PERF_LOCK&quot;) {
    Long totalReq = (Long) props.get(&quot;PERF_TOTAL_REQ&quot;); if (totalReq == null) totalReq = 0L;
    props.put(&quot;PERF_TOTAL_REQ&quot;, totalReq + 1);
    if (code.equals(&quot;200&quot;)) {
        Long success = (Long) props.get(&quot;PERF_SUCCESS&quot;); if (success == null) success = 0L;
        props.put(&quot;PERF_SUCCESS&quot;, success + 1);
        if (props.get(&quot;PERF_START_TS&quot;) == null) props.put(&quot;PERF_START_TS&quot;, now);
        props.put(&quot;PERF_END_TS&quot;, now + elapsed);
    } else {
        Long err = (Long) props.get(&quot;PERF_ERROR&quot;); if (err == null) err = 0L;
        props.put(&quot;PERF_ERROR&quot;, err + 1);
    }
    Long totalTime = (Long) props.get(&quot;PERF_TOTAL_TIME&quot;); if (totalTime == null) totalTime = 0L;
    props.put(&quot;PERF_TOTAL_TIME&quot;, totalTime + elapsed);
    Long minTime = (Long) props.get(&quot;PERF_MIN_TIME&quot;); if (minTime == null || elapsed &lt; minTime) props.put(&quot;PERF_MIN_TIME&quot;, elapsed);
    Long maxTime = (Long) props.get(&quot;PERF_MAX_TIME&quot;); if (maxTime == null || elapsed &gt; maxTime) props.put(&quot;PERF_MAX_TIME&quot;, elapsed);
}
String taskId = null;
int idx = res.indexOf(&quot;taskId&quot;);
if (idx &gt;= 0) {
    int s = res.indexOf(&quot;:&quot;, idx) + 1;
    while (s &lt; res.length() &amp;&amp; (res.charAt(s) == ' ' || res.charAt(s) == '&quot;')) s++;
    int e = s;
    while (e &lt; res.length() &amp;&amp; res.charAt(e) != '&quot;' &amp;&amp; res.charAt(e) != ',' &amp;&amp; res.charAt(e) != '}') e++;
    taskId = res.substring(s, e).trim();
}
vars.put(&quot;TASK_ID&quot;, taskId);
vars.put(&quot;TASK_SUBMIT_TIME&quot;, String.valueOf(now));
vars.put(&quot;TASK_POLL_DONE&quot;, &quot;false&quot;);
String runDir = props.get(&quot;RUN_DIR&quot;);
String ts = props.get(&quot;TEST_TS&quot;);
new File(runDir).mkdirs();
String csvPath = runDir + &quot;/aiOutfitToolsCheck_detail_&quot; + ts + &quot;.csv&quot;;
synchronized (csvPath.intern()) {
    File f = new File(csvPath);
    boolean needHeader = !f.exists();
    PrintWriter pw = new PrintWriter(new FileWriter(csvPath, true));
    if (needHeader) pw.println(&quot;username,code,taskId,elapsed,bytes,sentBytes,success&quot;);
    pw.println(vars.get(&quot;username&quot;) + &quot;,&quot; + code + &quot;,&quot; + (taskId == null ? &quot;&quot; : taskId) + &quot;,&quot; + elapsed + &quot;,&quot; + prev.getBytesAsLong() + &quot;,&quot; + prev.getSentBytesAsLong() + &quot;,&quot; + (code.equals(&quot;200&quot;) ? &quot;true&quot; : &quot;false&quot;));
    pw.close();
}
log.info(&quot;==== tools check recommend: code=&quot; + code + &quot; taskId=&quot; + taskId);</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="轮询结果-While" enabled="true">
          <stringProp name="WhileController.condition">${__javaScript(vars.get(&quot;TASK_POLL_DONE&quot;) != &quot;true&quot; &amp;&amp; vars.get(&quot;TASK_ID&quot;) != null,,)}</stringProp>
