        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="保存metrics后快照+对比" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import java.io.*;
String metrics = prev.getResponseDataAsString();
String runDir = props.get(&quot;RUN_DIR&quot;);
String ts = props.get(&quot;TEST_TS&quot;);
// 保存后快照
PrintWriter pw = new PrintWriter(new FileWriter(runDir + &quot;/metrics_after_&quot; + ts + &quot;.txt&quot;));
pw.print(metrics);
pw.close();
// 对比工具调用增量
StringBuilder diff = new StringBuilder();
diff.append(&quot;==== 工具调用增量对比 ====\n&quot;);
String[] toolNames = [&quot;price_balance&quot;, &quot;inventory&quot;, &quot;trending_styles&quot;, &quot;weather&quot;];
for (String t : toolNames) {
    String pattern = &quot;ai_tool_call_total{tool=\&quot;&quot; + t + &quot;\&quot;,status=\&quot;success\&quot;} &quot;;
    int idx = metrics.indexOf(pattern);
    long valAfter = 0;
    if (idx &gt;= 0) {
        int s = idx + pattern.length();
        int e = s;
        while (e &lt; metrics.length() &amp;&amp; Character.isDigit(metrics.charAt(e))) e++;
        try { valAfter = Long.parseLong(metrics.substring(s, e)); } catch (Exception ignore) {}
    }
    String beforeStr = props.get(&quot;METRIC_BEFORE_&quot; + t);
    long valBefore = beforeStr == null ? 0 : Long.parseLong(beforeStr);
    long delta = valAfter - valBefore;
    diff.append(t + &quot;: before=&quot; + valBefore + &quot; after=&quot; + valAfter + &quot; delta=&quot; + delta + &quot;\n&quot;);
    // 检查熔断状态
    String circuitPattern = &quot;ai_tool_circuit_state{tool=\&quot;&quot; + t + &quot;\&quot;} &quot;;
    int cidx = metrics.indexOf(circuitPattern);
    if (cidx &gt;= 0) {
        int s = cidx + circuitPattern.length();
        int e = s;
        while (e &lt; metrics.length() &amp;&amp; Character.isDigit(metrics.charAt(e))) e++;
        String state = metrics.substring(s, e);
        diff.append(t + &quot; circuit_state=&quot; + state + (state.equals(&quot;1&quot;) ? &quot; (OPEN-熔断中)&quot; : &quot; (CLOSED-正常)&quot;) + &quot;\n&quot;);
    }
}
// 写入对比文件
PrintWriter dpw = new PrintWriter(new FileWriter(runDir + &quot;/metrics_diff_&quot; + ts + &quot;.txt&quot;));
dpw.print(diff.toString());
dpw.close();
log.info(diff.toString());</stringProp>
          </JSR223PostProcessor>
