          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="查询result" enabled="true">
            <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
            <stringProp name="HTTPSampler.port">${PORT}</stringProp>
            <stringProp name="HTTPSampler.protocol">http</stringProp>
            <stringProp name="HTTPSampler.path">/api/v1/outfit/agent/result/${TASK_ID}</stringProp>
            <boolProp name="HTTPSampler.method">GET</boolProp>
            <boolProp name="HTTPSampler.use_keep_alive">true</boolProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="检查任务状态" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.io.*;
String res = prev.getResponseDataAsString();
long now = System.currentTimeMillis();
long submitTime = Long.parseLong(vars.get(&quot;TASK_SUBMIT_TIME&quot;));
long elapsed = (now - submitTime) / 1000;
String status = &quot;UNKNOWN&quot;;
int idx = res.indexOf(&quot;status&quot;);
if (idx &gt;= 0) {
    int s = res.indexOf(&quot;:&quot;, idx) + 1;
    while (s &lt; res.length() &amp;&amp; (res.charAt(s) == ' ' || res.charAt(s) == '&quot;')) s++;
    int e = s;
    while (e &lt; res.length() &amp;&amp; res.charAt(e) != '&quot;' &amp;&amp; res.charAt(e) != ',' &amp;&amp; res.charAt(e) != '}') e++;
    status = res.substring(s, e).trim();
}
log.info(&quot;==== poll result: status=&quot; + status + &quot; elapsed=&quot; + elapsed + &quot;s&quot;);
if (status.equalsIgnoreCase(&quot;SUCCESS&quot;) || status.equalsIgnoreCase(&quot;FAILED&quot;)) {
    vars.put(&quot;TASK_FINAL_STATUS&quot;, status);
    vars.put(&quot;TASK_POLL_DONE&quot;, &quot;true&quot;);
    String runDir = props.get(&quot;RUN_DIR&quot;);
    String ts = props.get(&quot;TEST_TS&quot;);
    String csvPath = runDir + &quot;/aiOutfitToolsCheck_status_&quot; + ts + &quot;.csv&quot;;
    synchronized (csvPath.intern()) {
        File f = new File(csvPath);
        boolean needHeader = !f.exists();
        PrintWriter pw = new PrintWriter(new FileWriter(csvPath, true));
        if (needHeader) pw.println(&quot;taskId,finalStatus,durationSec&quot;);
        pw.println(vars.get(&quot;TASK_ID&quot;) + &quot;,&quot; + status + &quot;,&quot; + elapsed);
        pw.close();
    }
} else if (elapsed &gt; 180) {
    vars.put(&quot;TASK_FINAL_STATUS&quot;, &quot;TIMEOUT&quot;);
    vars.put(&quot;TASK_POLL_DONE&quot;, &quot;true&quot;);
} else {
    try { Thread.sleep(3000); } catch (Exception ignore) {}
}</stringProp>
            </JSR223PostProcessor>
