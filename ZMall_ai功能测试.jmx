            <stringProp name="filename"></stringProp>
            <stringProp name="script">import java.io.*;
String caseName = &quot;R9-POST重复拒绝原因&quot;;
String expectedCode = &quot;409&quot;;
String actualCode = prev.getResponseCode();
long elapsed = prev.getTime();
boolean passed = actualCode.equals(&quot;409&quot;) || actualCode.equals(&quot;200&quot;) || actualCode.equals(&quot;404&quot;);
synchronized (&quot;PERF_LOCK&quot;) {
    Long totalReq = (Long) props.get(&quot;PERF_TOTAL_REQ&quot;); if (totalReq == null) totalReq = 0L;
    props.put(&quot;PERF_TOTAL_REQ&quot;, totalReq + 1);
    if (passed) {
        Long success = (Long) props.get(&quot;PERF_SUCCESS&quot;); if (success == null) success = 0L;
        props.put(&quot;PERF_SUCCESS&quot;, success + 1);
    } else {
        Long err = (Long) props.get(&quot;PERF_ERROR&quot;); if (err == null) err = 0L;
        props.put(&quot;PERF_ERROR&quot;, err + 1);
    }
}
String runDir = props.get(&quot;RUN_DIR&quot;);
String ts = props.get(&quot;TEST_TS&quot;);
String csvPath = runDir + &quot;/aiModelRating_validation_&quot; + ts + &quot;.csv&quot;;
synchronized (csvPath.intern()) {
    PrintWriter pw = new PrintWriter(new FileWriter(csvPath, true));
    pw.println(caseName + &quot;,&quot; + expectedCode + &quot;,&quot; + actualCode + &quot;,&quot; + elapsed + &quot;,&quot; + passed + &quot;,dupReject&quot;);
    pw.close();
}
log.info(&quot;==== Rating R9: case=&quot; + caseName + &quot; expected=&quot; + expectedCode + &quot; actual=&quot; + actualCode + &quot; passed=&quot; + passed);</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="R10-POST空拒绝原因(应400)" enabled="true">
          <stringProp name="HTTPSampler.domain">${HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/items/admin/ai-model/tasks/${TASK_ID_REJECT}/reject-reason</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keep_alive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;rejectReason&quot;:&quot;&quot;}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="记录R10空拒绝原因结果" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import java.io.*;
String caseName = &quot;R10-POST空拒绝原因&quot;;
// 400=校验失败（@NotBlank）；409=已反馈；404=任务不存在
String expectedCode = &quot;400&quot;;
String actualCode = prev.getResponseCode();
long elapsed = prev.getTime();
boolean passed = actualCode.equals(&quot;400&quot;) || actualCode.equals(&quot;409&quot;) || actualCode.equals(&quot;404&quot;);
synchronized (&quot;PERF_LOCK&quot;) {
    Long totalReq = (Long) props.get(&quot;PERF_TOTAL_REQ&quot;); if (totalReq == null) totalReq = 0L;
    props.put(&quot;PERF_TOTAL_REQ&quot;, totalReq + 1);
    if (passed) {
        Long success = (Long) props.get(&quot;PERF_SUCCESS&quot;); if (success == null) success = 0L;
        props.put(&quot;PERF_SUCCESS&quot;, success + 1);
    } else {
        Long err = (Long) props.get(&quot;PERF_ERROR&quot;); if (err == null) err = 0L;
        props.put(&quot;PERF_ERROR&quot;, err + 1);
    }
}
String runDir = props.get(&quot;RUN_DIR&quot;);
String ts = props.get(&quot;TEST_TS&quot;);
String csvPath = runDir + &quot;/aiModelRating_validation_&quot; + ts + &quot;.csv&quot;;
synchronized (csvPath.intern()) {
    PrintWriter pw = new PrintWriter(new FileWriter(csvPath, true));
    pw.println(caseName + &quot;,&quot; + expectedCode + &quot;,&quot; + actualCode + &quot;,&quot; + elapsed + &quot;,&quot; + passed + &quot;,emptyRejectReason&quot;);
    pw.close();
}
log.info(&quot;==== Rating R10: case=&quot; + caseName + &quot; expected=&quot; + expectedCode + &quot; actual=&quot; + actualCode + &quot; passed=&quot; + passed);</stringProp>
          </JSR223PostProcessor>
