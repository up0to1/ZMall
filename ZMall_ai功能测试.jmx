      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="AI随心搭-商品驱动功能验证组" enabled="false">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">0</intProp>
