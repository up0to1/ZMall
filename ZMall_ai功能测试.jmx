        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="保存metrics前快照" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">import java.io.*;
String metrics = prev.getResponseDataAsString();
String runDir = props.get(&quot;RUN_DIR&quot;);
String ts = props.get(&quot;TEST_TS&quot;);
PrintWriter pw = new PrintWriter(new FileWriter(runDir + &quot;/metrics_before_&quot; + ts + &quot;.txt&quot;));
pw.print(metrics);
pw.close();
// 提取工具调用基线值
String[] toolNames = [&quot;price_balance&quot;, &quot;inventory&quot;, &quot;trending_styles&quot;, &quot;weather&quot;];
for (String t : toolNames) {
    String pattern = &quot;ai_tool_call_total{tool=\&quot;&quot; + t + &quot;\&quot;,status=\&quot;success\&quot;} &quot;;
    int idx = metrics.indexOf(pattern);
    long val = 0;
    if (idx &gt;= 0) {
        int s = idx + pattern.length();
        int e = s;
        while (e &lt; metrics.length() &amp;&amp; Character.isDigit(metrics.charAt(e))) e++;
        try { val = Long.parseLong(metrics.substring(s, e)); } catch (Exception ignore) {}
    }
    props.put(&quot;METRIC_BEFORE_&quot; + t, String.valueOf(val));
    log.info(&quot;==== metrics before: &quot; + t + &quot;=&quot; + val);
}
log.info(&quot;==== metrics before snapshot saved&quot;);</stringProp>
